{
  "slug": "ticket-triager",
  "name": "Ticket Triager",
  "description": "Triages incoming tickets and issues",
  "category": "project_management",
  "kind": "ticket_triage",
  "tags": [
    "triage",
    "issues",
    "tickets"
  ],
  "icon": "hero-inbox-stack",
  "author": "Agentmancer",
  "suggested_trigger": {
    "type": "webhook",
    "name": "Ticket Events",
    "config": {
      "event_filter": [
        "issues.opened",
        "issues.labeled"
      ]
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "priority": {
        "type": "string",
        "enum": [
          "critical",
          "high",
          "medium",
          "low"
        ]
      },
      "type": {
        "type": "string",
        "enum": [
          "bug",
          "feature_request",
          "question",
          "documentation"
        ]
      },
      "labels": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "response": {
        "type": "string"
      },
      "suggested_assignee": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    },
    "required": [
      "priority",
      "type",
      "response",
      "summary"
    ]
  },
  "seed_default_workflow": true
}