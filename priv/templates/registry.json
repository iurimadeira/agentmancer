      "kind": "pr_review",
      "tags": ["review", "security", "quality"],
      "icon": "hero-magnifying-glass",
      "author": "Agentmancer",
      "suggested_trigger": {
        "type": "webhook",
        "name": "PR Events",
        "config": {"event_filter": ["pull_request.opened", "pull_request.synchronize"]}
      }
    },
