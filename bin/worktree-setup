#!/usr/bin/env bash
set -euo pipefail

BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
NC='\033[0m'

step() { printf "\n${BLUE}${BOLD}==> %s${NC}\n" "$1"; }
ok()   { printf "${GREEN}  ✓ %s${NC}\n" "$1"; }
warn() { printf "${YELLOW}  ! %s${NC}\n" "$1"; }

upsert_export() {
  local file="$1"
  local key="$2"
  local value="$3"

  python3 - "$file" "$key" "$value" <<'PY'
from pathlib import Path
import sys

file_path = Path(sys.argv[1])
key = sys.argv[2]
value = sys.argv[3]

line = f'export {key}="{value}"'
contents = file_path.read_text()
lines = contents.splitlines()

for index, existing in enumerate(lines):
    if existing.startswith(f"export {key}="):
        lines[index] = line
        break
else:
    if lines and lines[-1] != "":
        lines.append("")
    lines.append(line)

file_path.write_text("\n".join(lines) + "\n")
PY
}

slugify() {
  printf "%s" "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//; s/-+/-/g' \
    | cut -c1-40
}

cd "$(dirname "$0")/.."

printf "${BOLD}Agentmancer Worktree Setup${NC}\n"

# 0. Sync main worktree
step "Syncing main worktree"

MAIN_WORKTREE=$(
  git worktree list --porcelain | awk '
    /^worktree / { path = substr($0, 10) }
    /^branch refs\/heads\/main$/ { print path; exit }
  '
)

if [ -z "${MAIN_WORKTREE}" ]; then
  echo "Error: could not find a git worktree for branch main" >&2
  exit 1
fi

ok "Main worktree: ${MAIN_WORKTREE}"

if [ -n "$(git -C "${MAIN_WORKTREE}" status --porcelain)" ]; then
  warn "Main worktree has uncommitted changes — skipping sync"
else
  git -C "${MAIN_WORKTREE}" fetch origin main
  git -C "${MAIN_WORKTREE}" reset --hard origin/main
  git -C "${MAIN_WORKTREE}" clean -fd
  ok "Main worktree synced to origin/main"
fi

# 1. Environment
step "Setting up environment"

WORKTREE_NAME=$(basename "$(pwd)" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/_/g')
BRANCH_NAME="$(git branch --show-current 2>/dev/null || true)"
SLUG_SOURCE="${BRANCH_NAME:-${WORKTREE_NAME}}"
DEV_SLUG="$(slugify "${SLUG_SOURCE}")"

if [ -z "${DEV_SLUG}" ]; then
  DEV_SLUG="dev"
fi

# Preserve existing PORT if previously allocated
EXISTING_PORT=""
if [ -f .envrc ]; then
  EXISTING_PORT=$(grep '^export PORT=' .envrc | head -1 | sed 's/^export PORT=//' | tr -d '"')
fi

# Copy .envrc from main worktree (source of truth for API keys)
if [ -f "${MAIN_WORKTREE}/.envrc" ]; then
  cp "${MAIN_WORKTREE}/.envrc" .envrc
elif [ -f "${MAIN_WORKTREE}/.envrc.example" ]; then
  cp "${MAIN_WORKTREE}/.envrc.example" .envrc
else
  cp .envrc.example .envrc
fi

# Determine PORT: reuse existing or allocate new
if [ -n "$EXISTING_PORT" ] && [ "$EXISTING_PORT" != "4001" ]; then
  PORT="$EXISTING_PORT"
else
  command -v python3 &>/dev/null || { echo "Error: python3 is required for port allocation" >&2; exit 1; }

  PORT=$(python3 -c "
import socket, random
for port in random.sample(range(55000, 56000), 1000):
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.bind(('127.0.0.1', port))
        s.close()
        print(port)
        break
    except OSError:
        continue
else:
    raise SystemExit('No free port found in range 55000-55999')
")
fi

DB_NAME="agentmancer_dev_${WORKTREE_NAME}"
TEST_DB_NAME="agentmancer_test_${WORKTREE_NAME}"

upsert_export .envrc PORT "${PORT}"
upsert_export .envrc DB_NAME "${DB_NAME}"
upsert_export .envrc TEST_DB_NAME "${TEST_DB_NAME}"
upsert_export .envrc DEV_SLUG "${DEV_SLUG}"

if command -v direnv &>/dev/null; then
  direnv allow .
fi

set +u; source .envrc; set -u
ok "PORT=${PORT}, DB_NAME=${DB_NAME}"

# 2. Dependencies
step "Installing dependencies"
mix deps.get
ok "Done"

# 3. Database
step "Setting up database"
mix ecto.setup
ok "Database ready (${DB_NAME})"

# 4. Assets
step "Compiling assets"
mix assets.setup
mix assets.build
ok "Assets compiled"

# 5. Ensure direnv picks up the final .envrc
if command -v direnv &>/dev/null; then
  direnv allow .
fi

# Done
printf "\n${GREEN}${BOLD}Setup complete!${NC}\n\n"
printf "  Database:  ${DB_NAME}\n"
printf "  Port:      ${PORT}\n\n"
printf "Start the server with:\n"
printf "  ${BOLD}bin/dev${NC}\n\n"
