{
  "type": "object",
  "required": ["issues_reviewed", "issues_fixed", "issues_skipped", "summary"],
  "properties": {
    "issues_reviewed": { "type": "integer" },
    "issues_fixed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sentry_issue_id", "error_title", "root_cause", "pr_url"],
        "properties": {
          "sentry_issue_id": { "type": "string" },
          "error_title": { "type": "string" },
          "root_cause": { "type": "string" },
          "pr_url": { "type": "string" },
          "files_changed": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "issues_skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sentry_issue_id", "error_title", "reason"],
        "properties": {
          "sentry_issue_id": { "type": "string" },
          "error_title": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string" }
  }
}
